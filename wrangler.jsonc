{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourtab",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./apps/web/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}

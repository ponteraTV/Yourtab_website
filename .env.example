# Local object storage (docker compose up -d minio)
S3_REGION=us-east-1
S3_BUCKET=yourtab
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# The hostname clients use when PUTting a presigned URL. For a browser running
# on the host this is localhost; override it when clients run in Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000

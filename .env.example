# Shared application URLs
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# PostgreSQL / Redis
DATABASE_URL=postgresql://vaultstream:vaultstream@localhost:5432/vaultstream?schema=public
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vaultstream-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/vaultstream-media

# Secrets: replace with long, cryptographically random values outside local development.
SESSION_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP (optional in Phase 1; required once authentication email flows are enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VaultStream <no-reply@example.com>

# Development-only administrator seed inputs (used in Phase 2)
ADMIN_EMAIL=
ADMIN_PASSWORD=


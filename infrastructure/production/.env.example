# Copy this file to .env on the DigitalOcean server.
# Use strong unique values for every CHANGE_ME value.

POSTGRES_DB=vaultstream
POSTGRES_USER=vaultstream
POSTGRES_PASSWORD=CHANGE_ME_LONG_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_LONG_REDIS_PASSWORD

S3_BUCKET=vaultstream-media
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_MINIO_ADMIN
S3_SECRET_KEY=CHANGE_ME_LONG_MINIO_SECRET

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_LONG_ADMIN_PASSWORD

ACME_EMAIL=admin@your-domain.com

# DigitalOcean public hostnames. Replace 203-0-113-10 with your Droplet
# public IP using sslip.io syntax, e.g. 1-2-3-4.sslip.io.
API_DOMAIN=api.203-0-113-10.sslip.io
MEDIA_DOMAIN=media.203-0-113-10.sslip.io

# The browser uses the Cloudflare Pages same-origin /api proxy.
NEXT_PUBLIC_API_URL=/api
FRONTEND_URL=https://yourtab.pages.dev

# The API/worker use the internal MinIO endpoint.
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# Public media is served by the Caddy -> MinIO hostname.
# Keep the bucket prefix because MinIO is using path-style URLs.
S3_PUBLIC_BASE_URL=https://media.203-0-113-10.sslip.io/vaultstream-media
CDN_PUBLIC_BASE_URL=

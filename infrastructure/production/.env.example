# Native DigitalOcean deployment (no Docker).
# Copy to /opt/yourtab/infrastructure/production/.env and replace CHANGE_ME values.

NODE_ENV=production
PORT=4000

POSTGRES_DB=vaultstream
POSTGRES_USER=vaultstream
POSTGRES_PASSWORD=CHANGE_ME_LONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://vaultstream:CHANGE_ME_LONG_POSTGRES_PASSWORD@127.0.0.1:5432/vaultstream?schema=public

REDIS_PASSWORD=CHANGE_ME_LONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_REDIS_PASSWORD@127.0.0.1:6379

# DigitalOcean Spaces (recommended instead of MinIO).
S3_BUCKET=vaultstream-media
S3_REGION=sgp1
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_PRESIGN_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_PRESIGN_FORCE_PATH_STYLE=false
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=CHANGE_ME_SPACES_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_LONG_SPACES_SECRET
S3_PUBLIC_BASE_URL=https://vaultstream-media.sgp1.cdn.digitaloceanspaces.com
CDN_PUBLIC_BASE_URL=

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_LONG_ADMIN_PASSWORD

ACME_EMAIL=admin@your-domain.com
API_DOMAIN=api.203-0-113-10.sslip.io
MEDIA_DOMAIN=media.203-0-113-10.sslip.io
FRONTEND_URL=https://yourtab.yourtab.workers.dev

VIDEO_QUEUE=vaultstream:video-jobs
